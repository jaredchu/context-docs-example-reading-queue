{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "context-docs-example-reading-queue",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "context-docs-example-reading-queue",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "vars": {
    "APP_REVISION": "local"
  }
}
